<script lang="ts">
	import { hierarchy, treemap, type HierarchyNode } from 'd3-hierarchy';
	import { scaleOrdinal } from 'd3-scale';
	import data from './data.json';

	interface NodeData {
		name: string;
		value?: number;
		children?: NodeData[];
	}

	let width = $state(800);
	let height = $state(600);

	const rootNode = hierarchy<NodeData>(data);
	let idCounter = 0;
	rootNode.each((node) => {
		const path = node
			.ancestors()
			.map((d) => d.data.name)
			.reverse()
			.join('/');
		node.id = `${path}_${idCounter++}`;
	});

	rootNode
		.sum((d) => {
			if (d.children) return 0;
			const val = Math.max(d.value || 1, 1);
			return Math.sqrt(val);
		})
		.sort((a, b) => (b.value || 0) - (a.value || 0));

	let layoutNodes = $derived.by(() => {
		const w = Math.max(width, 100);
		const h = Math.max(height, 100);

		const treemapLayout = treemap<NodeData>()
			.size([w, h])
			.paddingTop(22)
			.paddingInner(4)
			.paddingOuter(4)
			.round(true);

		return treemapLayout(rootNode).descendants();
	});

	let currentFocus = $state<HierarchyNode<NodeData>>(rootNode);

	const colorScale = scaleOrdinal(['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6']);

	function getTransformedRect(node: HierarchyNode<NodeData>) {
		const currentWidth = currentFocus.x1 - currentFocus.x0;
		const currentHeight = currentFocus.y1 - currentFocus.y0;

		const kx = width / currentWidth;
		const ky = height / currentHeight;

		const x = (node.x0 - currentFocus.x0) * kx;
		const y = (node.y0 - currentFocus.y0) * ky;
		const w = (node.x1 - node.x0) * kx;
		const h = (node.y1 - node.y0) * ky;

		return { x, y, width: w, height: h };
	}

	function handleRectClick(node: HierarchyNode<NodeData>, event: MouseEvent) {
		event.stopPropagation();

		if (node !== currentFocus) {
			currentFocus = node;
		} else if (node.parent) {
			currentFocus = node.parent;
		}
	}

	function resetZoom() {
		currentFocus = rootNode;
	}

	let breadcrumbs = $derived(currentFocus ? currentFocus.ancestors().reverse() : []);

	function formatValue(val: unknown): string {
		if (typeof val === 'object' && val !== null) {
			return JSON.stringify(val, null, 2);
		}
		return String(val);
	}

	type DetailValue = string | number | boolean | null | undefined | DetailValue[] | { [key: string]: DetailValue };

const EXCLUDE_KEYS = new Set([
	'children',
	'details',
	'Details',
	'name',
	'Name',
	'value',
	'Value',
	'Doku',
	'Dokumente'
]);

function getCleanData(data: Record<string, unknown>): Record<string, unknown> {
	let combined: Record<string, unknown> = { ...data };

	const rawDetails = data.details ?? data.Details;

	if (typeof rawDetails === 'string') {
		try {
			const parsed: unknown = JSON.parse(rawDetails);
			if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
				combined = { ...combined, ...(parsed as Record<string, unknown>) };
			}
		} catch {
			/* Ignorieren falls kein valides JSON */
		}
	} else if (rawDetails && typeof rawDetails === 'object' && !Array.isArray(rawDetails)) {
		combined = { ...combined, ...(rawDetails as Record<string, unknown>) };
	}

	const result: Record<string, unknown> = {};
	for (const [key, val] of Object.entries(combined)) {
		if (!EXCLUDE_KEYS.has(key) && val !== null && val !== undefined && val !== '') {
			result[key] = val;
		}
	}

	return result;
}
</script>

<div class="flex h-full w-full flex-col gap-4 p-6">
	<!-- Breadcrumb Header -->
	<div class="flex flex-wrap items-center justify-between gap-4">
		<nav aria-label="Breadcrumb" class="flex items-center text-sm">
			<ol class="flex flex-wrap items-center gap-1.5 text-muted-foreground">
				{#each breadcrumbs as node, index (node.id)}
					<li class="inline-flex items-center gap-1.5">
						{#if index > 0}
							<span class="text-slate-500 opacity-60">/</span>
						{/if}

						{#if index === breadcrumbs.length - 1}
							<span class="font-semibold text-foreground">
								{node.data.name}
							</span>
						{:else}
							<button
								onclick={() => (currentFocus = node)}
								class="transition-colors hover:text-foreground hover:underline"
							>
								{node.data.name}
							</button>
						{/if}
					</li>
				{/each}
			</ol>
		</nav>

		{#if currentFocus !== rootNode && currentFocus.parent}
			<button
				onclick={() => (currentFocus = currentFocus.parent!)}
				class="rounded-md border bg-background px-3 py-1.5 text-xs font-medium shadow-sm hover:bg-accent hover:text-accent-foreground"
			>
				← Eine Ebene hoch
			</button>
		{/if}
	</div>

	<!-- Treemap Container -->
	<div
		bind:clientWidth={width}
		bind:clientHeight={height}
		class="relative h-[calc(100vh-180px)] w-full overflow-hidden rounded-xl bg-slate-900/5 p-2 dark:bg-slate-900"
	>
		<svg {width} {height} viewBox="0 0 {width} {height}" class="h-full w-full">
			<rect
				{width}
				{height}
				fill="transparent"
				role="button"
				tabindex="0"
				aria-label="Zoom zurücksetzen"
				onclick={resetZoom}
				onkeydown={(e) => (e.key === 'Enter' || e.key === ' ') && resetZoom()}
				class="cursor-pointer"
			/>

			{#each layoutNodes as node (node.id)}
				{@const rect = getTransformedRect(node)}
				{@const depthDiff = node.depth - currentFocus.depth}

				{#if depthDiff >= 0 && depthDiff <= 1 && rect.width > 2 && rect.height > 2}
					<g
	transform="translate({rect.x},{rect.y})"
	role="button"
	tabindex="0"
	aria-label={node.data.name}
	onclick={(e) => handleRectClick(node, e)}
	onkeydown={(e) => {
		if (e.key === 'Enter' || e.key === ' ') {
			e.preventDefault();
			handleRectClick(node, e);
		}
	}}
	class="cursor-pointer transition-all duration-300 ease-out focus-visible:outline focus-visible:outline-primary"
>
						<rect
							width={rect.width}
							height={rect.height}
							fill={colorScale(node.depth.toString())}
							fill-opacity={node === currentFocus ? 0.15 : 0.85}
							stroke="#ffffff"
							stroke-width={node === currentFocus ? '2' : '1'}
							rx="6"
							class="hover:fill-opacity-100 transition-opacity"
						/>

						<!-- Detailansicht bei fokussiertem Blattknoten -->
						{#if node === currentFocus && !node.children}
							{@const details = getCleanData(node.data)}

							<foreignObject x="0" y="0" width={rect.width} height={rect.height} class="p-4">
								<div
									class="flex h-full w-full flex-col gap-5 overflow-hidden rounded-xl border border-slate-800 bg-slate-950/95 p-6 text-white shadow-2xl backdrop-blur-md"
								>
									<!-- Header -->
									<div class="flex items-start justify-between border-b border-slate-800 pb-4">
										<div>
											<div class="flex items-center gap-2">
												<span
													class="rounded border border-emerald-500/20 bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold tracking-wider text-emerald-400 uppercase"
												>
													Anlagenteil
												</span>
												{#if details.Status}
													<span
														class="rounded border border-blue-500/20 bg-blue-500/10 px-2 py-0.5 text-[11px] font-semibold text-blue-400"
													>
														{details.Status}
													</span>
												{/if}
											</div>
											<h2 class="mt-2 text-2xl font-bold tracking-tight text-white">
												{node.data.name}
											</h2>
										</div>

										<div class="text-right font-mono text-xs text-slate-400">
											<div>
												ID: <span class="text-slate-200">{details.ID || node.id!.split('_')[0]}</span
												>
											</div>
											{#if details['Equipment-Nr. Anlage']}
												<div class="mt-0.5">
													Eq.-Nr: <span class="text-slate-200"
														>{details['Equipment-Nr. Anlage']}</span
													>
												</div>
											{/if}
										</div>
									</div>

									<!-- Kennzahlen -->
									<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
										<div class="rounded-lg border border-slate-800/80 bg-slate-900/80 p-3">
											<span class="text-[11px] font-medium text-slate-400">Gebäude</span>
											<p class="mt-1 font-semibold text-slate-100">{details.Gebäude || '-'}</p>
										</div>
										<div class="rounded-lg border border-slate-800/80 bg-slate-900/80 p-3">
											<span class="text-[11px] font-medium text-slate-400">Standort</span>
											<p class="mt-1 font-semibold text-slate-100">{details.Standort || '-'}</p>
										</div>
										<div class="rounded-lg border border-slate-800/80 bg-slate-900/80 p-3">
											<span class="text-[11px] font-medium text-slate-400">Gefährdungstyp</span>
											<p class="mt-1 font-semibold text-amber-400">
												{details.Gefährdungstyp || '-'}
											</p>
										</div>
										<div class="rounded-lg border border-slate-800/80 bg-slate-900/80 p-3">
											<span class="text-[11px] font-medium text-slate-400">Volumen Gesamt</span>
											<p class="mt-1 font-mono font-semibold text-emerald-400">
												{details.Volumen_Gesamt ?? details.Value ?? '-'}
											</p>
										</div>
									</div>

									<!-- Details Grid -->
									<div class="flex-1 overflow-y-auto pr-1">
										<h3 class="mb-3 text-xs font-semibold tracking-wider text-slate-400 uppercase">
											Spezifikationen & Eigenschaften
										</h3>

										<dl class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
											{#each Object.entries(details) as [key, val] (key)}
												{#if !['Status', 'ID', 'Gebäude', 'Standort', 'Gefährdungstyp', 'Volumen_Gesamt'].includes(key)}
													<div
														class="flex flex-col justify-between rounded-lg border border-slate-800/50 bg-slate-900/50 p-2.5 transition-colors hover:border-slate-700/60"
													>
														<dt class="text-[11px] font-medium text-slate-400">{key}</dt>
														<dd
															class="mt-1 font-mono text-xs font-semibold wrap-break-words text-slate-200"
														>
															{formatValue(val)}
														</dd>
													</div>
												{/if}
											{/each}
										</dl>
									</div>
								</div>
							</foreignObject>

							<!-- Vorschau-Kachel -->
						{:else if depthDiff === 1}
							{#if rect.width > 40 && rect.height > 25}
								<text
									x="12"
									y="24"
									font-size="13"
									font-weight="bold"
									fill="#ffffff"
									class="pointer-events-none select-none"
								>
									{node.data.name}
								</text>

								{#if rect.height > 45}
									<text
										x="12"
										y="42"
										font-size="11"
										fill="#e2e8f0"
										class="pointer-events-none select-none"
									>
										{#if node.children}
											{node.children.length} Anlagenteile
										{/if}
									</text>
								{/if}
							{/if}
						{/if}
					</g>
				{/if}
			{/each}
		</svg>
	</div>
</div>
